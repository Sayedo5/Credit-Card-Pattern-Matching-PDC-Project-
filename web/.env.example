# URL of the CUDA backend (server/app.py running on a machine with an NVIDIA GPU).
#
# Colab: paste the https://....trycloudflare.com URL the tunnel cell prints.
# Local GPU box: http://localhost:8000
#
# You can also set this at runtime from the app's "change" link, which is
# easier because the Colab tunnel URL is different every session.
VITE_API_URL=http://localhost:8000
